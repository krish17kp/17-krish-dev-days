---
import Header from "../components/Header.astro"
import "../styles/global.css"

interface Props {
  title?: string;
}

const { title = "Tailspin Toys" } = Astro.props;
---

<!doctype html>
<html lang="en" class="dark">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <meta name="generator" content={Astro.generator} />
        <title>{title}</title>
        <script is:inline>
            const highContrastPreference = localStorage.getItem('tailspin-high-contrast');
            if (highContrastPreference === 'true') {
                document.documentElement.classList.add('high-contrast');
            }
        </script>
        <!-- Preconnect to improve font loading -->
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    </head>
    <body class="min-h-screen bg-slate-900 text-white transition-colors duration-300 m-0 w-full h-full font-sans">
        <Header />
        <main class="container mx-auto py-6 h-full max-w-7xl">
            <div class="px-4 sm:px-6 lg:px-8">
                <slot />
            </div>
        </main>
    </body>
</html>

<style is:global>
    :root {
        --font-sans: 'Inter', system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, 'Open Sans', 'Helvetica Neue', sans-serif;
    }
    
    html {
        font-family: var(--font-sans);
        scroll-behavior: smooth;
    }
    
    body {
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
    }

    html.high-contrast {
        color-scheme: dark;
    }

    html.high-contrast body,
    html.high-contrast .bg-slate-900 {
        background-color: #000;
        color: #fff;
    }

    html.high-contrast header,
    html.high-contrast .bg-blue-700,
    html.high-contrast .dark\:bg-blue-800 {
        background-color: #000;
        border-bottom: 2px solid #fff;
    }

    html.high-contrast .bg-slate-800,
    html.high-contrast .bg-slate-800\/60,
    html.high-contrast .bg-slate-800\/50,
    html.high-contrast .dark\:bg-slate-800 {
        background-color: #111;
        color: #fff;
    }

    html.high-contrast .text-slate-100,
    html.high-contrast .text-slate-200,
    html.high-contrast .text-slate-300,
    html.high-contrast .text-slate-400,
    html.high-contrast .text-white,
    html.high-contrast .text-blue-400,
    html.high-contrast .text-purple-400 {
        color: #fff;
    }

    html.high-contrast .border-slate-600,
    html.high-contrast .border-slate-700,
    html.high-contrast .border-slate-700\/50 {
        border-color: #fff;
    }

    html.high-contrast a,
    html.high-contrast button {
        text-decoration-thickness: 2px;
    }

    html.high-contrast :is(a, button, input, select):focus-visible {
        outline: 3px solid #ff0;
        outline-offset: 3px;
        box-shadow: none;
    }

    html.high-contrast .hover\:bg-slate-700:hover,
    html.high-contrast .dark\:hover\:bg-slate-700:hover,
    html.high-contrast .hover\:bg-slate-100:hover {
        background-color: #333;
        color: #fff;
    }
</style>
